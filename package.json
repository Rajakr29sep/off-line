{
  "name": "kiwix-emergency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix \"[{name}]\" --names \"backend,frontend,rag\" -c \"blue,green,yellow\" \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:rag\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:rag": "node scripts/dev-rag.js",
    "index": "node scripts/run-index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
